{
  "name": "level-up-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Level Up authenticated planner API. Based on Streak by InlitX.",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:init": "node --env-file-if-exists=.env scripts/init-db.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:unit": "node --test test/domain.test.js",
    "test:integration": "node --test test/api.test.js",
    "test:serve": "node scripts/local-test-server.js",
    "check": "node --check src/app.js && node --check src/domain.js && node --check src/store.js && node --check src/auth.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "luxon": "^3.7.2",
    "mongodb": "^7.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1"
  }
}
