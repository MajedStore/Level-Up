# Server-side only. Never copy this connection string or JWT key into Flutter.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=level_up
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=level-up-api
JWT_AUDIENCE=level-up-android
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=30
# Optional Google Sign-In. This is the Web OAuth client ID used as the
# backend's accepted Google ID-token audience. It is not a client secret.
GOOGLE_OAUTH_WEB_CLIENT_ID=
# Optional password-reset delivery through Resend. Both values are required
# before reset requests are accepted. Keep the API key server-side only.
RESEND_API_KEY=
EMAIL_FROM=
# Browser clients only; native Android does not need a CORS origin.
CORS_ORIGINS=
# Set 1 only behind exactly one trusted HTTPS reverse proxy; otherwise keep 0.
TRUST_PROXY_HOPS=0
