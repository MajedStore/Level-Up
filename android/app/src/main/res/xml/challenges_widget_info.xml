<?xml version="1.0" encoding="utf-8"?>
<!-- Level Up challenges widget: today's package, its progress and tasks.
     Refreshed by the app on every planner change. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="80dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/challenges_widget_description"
    android:initialLayout="@layout/widget_challenges_loading"
    android:previewImage="@drawable/challenges_widget_preview" />
